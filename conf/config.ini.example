# Copy to ~/.config/gnome-google-workspace-search/config.ini and edit.
# Every key is optional; the values below are the defaults.
# `gnome-google-workspace-search --setup` writes [services] and search.mode for you.

[services]
# Each one is its own section in the Activities overview. After enabling one,
# run --setup (or --login) so your accounts authorize it.
drive = true
contacts = true
gmail = false
calendar = false

[search]
# name: match file names. fulltext: also match file contents (slower, no sorting by
# date; requires accounts added with --login --fulltext).
mode = name
max_results = 10
min_chars = 3
# Milliseconds to wait after the last keystroke before querying the API.
debounce_ms = 250
# Include shared drives in results.
shared_drives = true
# Exit the background process after this many seconds without searches.
idle_exit_seconds = 300

[auth]
# Accounts are normally added with: gnome-google-workspace-search --login
# Optional extra account from an existing token file in google-auth
# "authorized_user" JSON format (keys: client_id, client_secret, refresh_token)
# that has a Drive scope. Also settable with GNOME_DRIVE_SEARCH_TOKEN_FILE.
# token_file = ~/.config/my-tool/google_token.json

[browser]
# Open each result in the browser profile signed in to the account that found it
# (Chrome, Chromium, Brave, Edge, Vivaldi). Detected automatically.
use_profiles = true

# Manual mapping for profiles that are not signed in to the browser itself.
# The directory name is the last part of "Profile Path" in chrome://version.
# [browser_profiles]
# me@work.com = Profile 2
